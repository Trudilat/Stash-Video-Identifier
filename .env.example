# ── Stash connection ──────────────────────────────────────────────────────────
STASH_URL=http://localhost:9999
STASH_API_KEY=your_api_key_here

# ── Path mapping ──────────────────────────────────────────────────────────────
# Stash always reports file paths as the *server* sees them.
# If this pipeline runs on a different machine (or the paths differ for any
# other reason), you need to tell it how to translate those paths into ones
# that are valid on *this* machine.
#
# How it works:
#   1. Strip STASH_PATH_PREFIX from the start of the Stash path
#   2. Prepend LOCAL_PATH_PREFIX
#
# To find the right values:
#   - Open any scene in Stash and note the file path shown (e.g. /data/videos/...)
#     That is what Stash reports → use the leading portion as STASH_PATH_PREFIX
#   - Find that same file on this machine and note its path
#     The part before the shared folder structure is LOCAL_PATH_PREFIX
#
# ── Scenario A: Stash on a Linux server, pipeline on a Windows PC via SMB ──
#
#   The server stores files at : /data/videos/Creator/video.mp4
#   You mount the share on     : Z:\videos\Creator\video.mp4
#   (i.e. Z:\ maps to /data on the server)
#
#   STASH_PATH_PREFIX=/data
#   LOCAL_PATH_PREFIX=Z:\
#
#   Result: /data/videos/Creator/video.mp4
#        →  Z:\videos\Creator\video.mp4
#
# ── Scenario B: Stash in Docker, pipeline on the same host ─────────────────
#
#   Inside the container files are at : /data/videos/Creator/video.mp4
#   On the host they live at          : /mnt/stash/videos/Creator/video.mp4
#
#   STASH_PATH_PREFIX=/data
#   LOCAL_PATH_PREFIX=/mnt/stash
#
# ── Scenario C: Stash and pipeline on the same machine, paths identical ─────
#
#   No translation needed — leave both variables empty.
#
#   STASH_PATH_PREFIX=
#   LOCAL_PATH_PREFIX=
#
STASH_PATH_PREFIX=/data
LOCAL_PATH_PREFIX=/mnt/stash

# ── Temp files ────────────────────────────────────────────────────────────────
TEMP_DIR=tmp

# ── Whisper transcription ─────────────────────────────────────────────────────
# Model sizes: tiny | base | small | medium | large-v3-turbo
WHISPER_MODEL=large-v3-turbo

# Device: "cpu" (works everywhere) or "cuda" (NVIDIA GPU — much faster)
# WHISPER_DEVICE=cpu

# Compute type: "int8" for CPU, "float16" or "int8_float16" for CUDA
# WHISPER_COMPUTE=int8

# CPU threads — ignored when WHISPER_DEVICE=cuda
WHISPER_THREADS=8

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# Vision model — describes video frames (must be a multimodal/vision model)
OLLAMA_VISION_MODEL=qwen3-vl:8b

# LLM — writes titles and descriptions
# Any capable instruction model works. Larger = better quality.
OLLAMA_LLM_MODEL=mistral

# LLM — selects tags (optional — falls back to OLLAMA_LLM_MODEL if not set)
# A separate model can be used here if you want different behaviour for tagging.
OLLAMA_TAGS_MODEL=mistral

# ── In-app settings ───────────────────────────────────────────────────────────
# Frames per video, minimum duration, minimum tag scene count, and generation
# toggles are all configured through the Settings menu inside the app.
# They are saved automatically and do not need to be set here.
